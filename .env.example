# Copy to .env and fill in. .env is gitignored (see .gitignore); THIS file is committed and must
# never contain a real value.
#
# ---------------------------------------------------------------------------------------------
# Generating the password
# ---------------------------------------------------------------------------------------------
#
#   openssl rand -hex 32
#
# Use `-hex`, NOT `-base64`. CLAUDE.md § 5: base64's alphabet includes `/` and `+`, both of which
# are meaningful inside a URI. A password containing them does not fail as an authentication
# error — it fails as a confusing host-and-port parse error from whatever is reading
# DATABASE_URL, several layers away from the actual cause.
#
# Generate it on the machine that will run the database. Do not paste it into a chat window, a
# ticket, or an agent session (CLAUDE.md § 1).

# ---------------------------------------------------------------------------------------------
# Consumed by docker-compose.yml (the timescaledb service)
# ---------------------------------------------------------------------------------------------
POSTGRES_DB=waterway
POSTGRES_USER=waterway
POSTGRES_PASSWORD=CHANGEME-run-openssl-rand-hex-32-and-paste-the-output-here

# ---------------------------------------------------------------------------------------------
# Consumed by the application (app/db.py) — the migration runner, the @job decorator, the
# APScheduler job store, and the heartbeat all read this one variable and nothing else.
# ---------------------------------------------------------------------------------------------
#
# The password here must be THE SAME VALUE as POSTGRES_PASSWORD above. It is written out twice
# because the two consumers take it in different shapes, not because they are different secrets.
#
# THE HOST HERE STAYS `localhost`, AND PHASE 12 DID NOT CHANGE THAT.
#
# The expectation recorded here through Phase 11 was that containerizing the scheduler would move
# this to `timescaledb:5432` and retire the out-of-repo override that publishes 5432 on loopback.
# It does not, and the reason is worth writing down rather than rediscovering: HOST-SIDE TOOLING
# STILL NEEDS A HOST-REACHABLE DSN. The migration runner, `verify/preflight.py`'s migration gate
# and every `verify/phase11` stage connect from the host - and the runner cannot simply move into
# a container, because the images deliberately do not contain `migrations/` (CLAUDE.md § 3).
#
# The scheduler container does NOT read this variable. docker-compose.yml assembles its DATABASE_URL
# from POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB with the host `timescaledb`, so the container
# gets the right host without a fourth copy of the password living in this file.
#
# THIS VARIABLE IS NOT GIVEN TO THE api CONTAINER. See API_DATABASE_URL below.
DATABASE_URL=postgresql://waterway:CHANGEME-same-value-as-POSTGRES_PASSWORD@localhost:5432/waterway

# ---------------------------------------------------------------------------------------------
# Consumed by the api CONTAINER (Phase 10) — and by nothing else
# ---------------------------------------------------------------------------------------------
#
# THE READ-ONLY ROLE. `waterway_api` is created by a human with GRANT SELECT and nothing else, and
# the live procedure PROVES it by watching a DELETE fail — a read-only role that has never been
# observed refusing a write is not known to be read-only (CLAUDE.md § 20). Its password is its
# own, generated the same way as the owner's:
#
#     openssl rand -hex 32
#
# THE HOST IS `timescaledb`, NOT `localhost`, AND THIS IS THE ONE VALUE PHASE 10 CHANGES.
#
# Through Phase 9 the API ran under uvicorn on the host, beside the out-of-repo override that
# published 5432 on loopback, so `@localhost:5432` worked. From Phase 10 it runs inside a
# container on the Compose network, where loopback is that container's OWN namespace and nothing
# is listening on 5432 there. The host must be the Compose service name.
#
# Getting it wrong is a connection-refused at container start — loud, immediate, and in
# `docker compose logs api`. It is not a subtle failure; it is just one nobody expects, because
# the string looks identical to the one that worked yesterday.
#
# docker-compose.yml passes this through as `${API_DATABASE_URL:?...}`, so an unset value stops
# the container rather than starting one that silently falls back to the owner role. The api
# container is deliberately NOT given DATABASE_URL, so that fallback has nothing to fall back to.
API_DATABASE_URL=postgresql://waterway_api:CHANGEME-run-openssl-rand-hex-32-for-the-read-only-role@timescaledb:5432/waterway

# ---------------------------------------------------------------------------------------------
# Consumed by the scheduler CONTAINER (Phase 12)
# ---------------------------------------------------------------------------------------------
#
# NOT A SECRET, and it is here rather than in docker-compose.yml because it carries the AWS account
# id - it is environment-specific, and a literal in the committed compose file would be one more
# thing that is wrong in any other account. It is the terraform output `backup_bucket_name`:
#
#     cd infra/terraform && terraform output -raw backup_bucket_name
#
# The scheduler container gets NO AWS CREDENTIALS. boto3 obtains them from the instance role over
# IMDS; there are no AWS keys in this file, ever.
BACKUP_BUCKET=domestic-waterway-signals-backups-CHANGEME-your-account-id
