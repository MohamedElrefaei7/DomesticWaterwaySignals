# Copy to terraform.tfvars (git-ignored) and fill in real values. Never commit terraform.tfvars.

aws_region        = "us-east-1"
availability_zone = "us-east-1a"

# CIDR allowed to SSH in. Must be /24 or narrower. Never 0.0.0.0/0.
ssh_admin_cidr = "203.0.113.0/24"

# PLACEHOLDER — Ubuntu 24.04 LTS (Noble Numbat) amd64 AMI for us-east-1, as of this commit.
# Verify against https://cloud-images.ubuntu.com/locator/ec2/ before applying; AMI IDs are
# region-specific and Canonical periodically republishes the "24.04 LTS" name against a new ID.
ami_id = "ami-0XXXXXXXXXXXXXXXX"

instance_type        = "t3.small"
root_volume_size_gb  = 20
data_volume_size_gb  = 50
