# ---------------------------------------------------------------------------
# Secrets — these must never be committed. .env.example IS committed.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ---------------------------------------------------------------------------
# Terraform — state can contain secrets in plaintext; tfvars usually does.
# ---------------------------------------------------------------------------
.terraform/
.terraform.lock.hcl.bak
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
*.plan.json
# NOTE: .terraform.lock.hcl IS committed — it pins provider versions.

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ---------------------------------------------------------------------------
# Node / Vite frontend
# ---------------------------------------------------------------------------
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# ---------------------------------------------------------------------------
# Local data, dumps, logs — never in git
# ---------------------------------------------------------------------------
*.dump
*.sql.gz
data/
logs/
*.log

# ---------------------------------------------------------------------------
# Editor / OS
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ---------------------------------------------------------------------------
# Local Compose overrides — machine-specific, never shared.
# ---------------------------------------------------------------------------
# docker-compose.override.yml is applied automatically by `docker compose` with
# no flag, so anything in it changes what runs while being invisible in
# docker-compose.yml. Phase 2 uses one to publish 5432 on loopback for the
# host-venv scheduler; committing that would put a published database port
# into every environment silently. See CLAUDE.md § 6.
docker-compose.override.yml

